# Copy to .env and change the password: cp .env.example .env
POSTGRES_USER=kbo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kbo
POSTGRES_PORT=5432

# LLM 에이전트 (Claude)
# ANTHROPIC_API_KEY=   # 또는 `ant auth login` 으로 로그인하면 비워 둬도 됨
