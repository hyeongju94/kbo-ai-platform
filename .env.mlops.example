# cp .env.mlops.example .env.mlops 후 비밀번호 변경 (MLflow + MinIO + Airflow 설정, git 에 올리지 않음)
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me
MLFLOW_DB_NAME=mlflow

MINIO_ROOT_USER=kbo-minio
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
SNAPSHOT_BUCKET=kbo-snapshots

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow
# 웹 UI 로그인: admin / 아래 비밀번호
AIRFLOW_ADMIN_PASSWORD=change-me
# Airflow 내부 키. 만들기: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=
# 만들기: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=
